    </qresource>
    <qresource prefix="/address">
        <file>CountryComboBox.qml</file>
        <file>AddressAPI.qml</file>
        <file>AddressSelector.qml</file>
        <file>MunicipalityComboBox.qml</file>
        <file>SectorCombBox.qml</file>
    </qresource>
</RCC>
