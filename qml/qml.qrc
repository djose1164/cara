<RCC>
    <qresource prefix="/home">
        <file>Home.qml</file>
        <file>UserHome.qml</file>
        <file>HomeHeader.qml</file>
        <file>AdminHome.qml</file>
        <file>Welcome.qml</file>
        <file>Offers.qml</file>
    </qresource>
    <qresource prefix="/orders">
        <file>Entry.qml</file>
        <file>BuyOrder.qml</file>
        <file>BuyOrderForm.qml</file>
        <file>BuyOrderDetails.qml</file>
        <file>BuyOrderView.qml</file>
        <file>BuyOrderHeader.qml</file>
    </qresource>
    <qresource prefix="/provider"/>
    <qresource lang="qml" prefix="/errors">
        <file>ErrorPage.qml</file>
    </qresource>
    <qresource prefix="/inventory">
        <file>Inventory.qml</file>
        <file>InventoryAPI.qml</file>
    </qresource>
    <qresource prefix="/cart">
        <file>Cart.qml</file>
        <file>CartContent.qml</file>
        <file>Checkout.qml</file>
        <file>EmptyCart.qml</file>
    </qresource>
    <qresource lang="qml" prefix="/filters">
